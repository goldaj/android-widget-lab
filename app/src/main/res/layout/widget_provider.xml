<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetLayout_id"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/cityValue_id"
        android:text="@string/city_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/aqiLabel_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aqi_label" />
        <TextView
            android:id="@+id/aqiValue_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aqi_value" />
    </LinearLayout>

    <TextView
        android:id="@+id/healthValue_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_value" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/temperatureLabel_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/temperature_label" />
        <TextView
            android:id="@+id/temperatureValue_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/temperature_value" />
        <TextView
            android:id="@+id/temperatureUnite_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/degree_label" />
    </LinearLayout>

    <TextView
        android:id="@+id/updatedValue_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_value" />
</LinearLayout>
